source "https://rubygems.org"

# Matches the Jekyll version and plugins GitHub Pages uses to build the site.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Standard-library gems that newer Ruby versions no longer bundle by default,
# but Jekyll 3.x still needs.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
